{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} | {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default .Summary | plainify }}</description>
    <language>{{ .Site.Language.Lang }}</language>
    <managingEditor>{{ with .Site.Params.email }}{{ . }}{{ end }} ({{ .Site.Title }})</managingEditor>
    <webMaster>{{ with .Site.Params.email }}{{ . }}{{ end }} ({{ .Site.Title }})</webMaster>
    {{ with .Site.Params.twitter }}
    <atom:link href="{{ $.Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <author>{{ with .Params.author }}{{ . }}{{ end }}</author>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | html }}</description>
      {{ with .Params.categories }}
      {{ range . }}
      <category>{{ . }}</category>
      {{ end }}
      {{ end }}
      <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>
    </item>
    {{ end }}
  </channel>
</rss>
